# Google OAuth web client ID. This must match GOOGLE_CLIENT_ID in apps/api/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:4001

# S3-compatible storage used by the server-side image upload route.
# Keep credentials server-only: do not add the NEXT_PUBLIC_ prefix.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public bucket or CDN base URL, without a trailing slash.
S3_PUBLIC_URL=https://your-bucket.s3.your-region.amazonaws.com

# Optional for non-AWS S3-compatible providers.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
