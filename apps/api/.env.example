# Google OAuth web client ID used to verify authenticated API requests.
GOOGLE_CLIENT_ID=

# Development uses a local SQLite file. Production can use libsql://... (Turso).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Browser origin allowed to call the API.
WEB_ORIGIN=http://localhost:4000
# Optional shared parent domain when the web and API use different subdomains.
# Required for authenticated web-server routes such as image uploads in that setup.
SESSION_COOKIE_DOMAIN=
HOST=0.0.0.0
PORT=4001
