# Reference list of all environment variables used by the workspace.
# The apps do not load this root file when started through pnpm. For local
# development, copy the app-specific examples in apps/api and apps/web instead.

# Google OAuth web client ID. Use the same value in both applications.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:4001

# Development uses a local SQLite file. Production can use libsql://... (Turso).
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
WEB_ORIGIN=http://localhost:4000
SESSION_COOKIE_DOMAIN=
PORT=4001

# S3-compatible storage used by the web application for authenticated image uploads.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public bucket or CDN base URL, without a trailing slash.
S3_PUBLIC_URL=https://your-bucket.s3.your-region.amazonaws.com
# Optional for non-AWS S3-compatible providers.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
